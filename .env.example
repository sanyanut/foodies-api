# ─────────────────────────────────────────────────────────────
# Foodies API — environment variables
# Copy to `.env` and fill in the values for local development.
# ─────────────────────────────────────────────────────────────

# App
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Database (Prisma) — connection string used by the API process.
# Local (running the API on the host against the Docker DB):
DATABASE_URL=postgresql://foodies:foodies@localhost:5432/foodies?schema=public

# JWT — access + refresh use separate secrets. Generate strong random values.
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# CORS — comma-separated whitelist. Leave EMPTY to allow all origins ("*"),
# which is the intended setting for development.
ALLOWED_ORIGINS=

# Swagger UI (/api-docs). Always available outside production; in production it
# is OFF unless you set this to "true" (e.g. to expose docs on Render).
ENABLE_DOCS=false

# Popular-recipes response cache (seconds). The frontend polls this endpoint.
POPULAR_RECIPES_CACHE_TTL=60

# Cloudinary (avatar / recipe image uploads) "optional in /config/env.ts zod schema"
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── docker-compose only (Postgres container) ──
POSTGRES_DB=foodies
POSTGRES_USER=foodies
POSTGRES_PASSWORD=foodies
DB_HOST_PORT=5432
APP_PORT=3000
